# Edge Function secrets. Copy to supabase/functions/.env (git-ignored), then:
#   npx supabase@2.122.0 secrets set --env-file supabase/functions/.env
ANTHROPIC_API_KEY=sk-ant-...
# Any long random string. The same value goes into Vault as 'cleanup_secret' (see README).
CLEANUP_SECRET=change-me-to-a-long-random-string
